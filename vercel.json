{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "buildCommand": "python3 -m pip install --quiet --disable-pip-version-check --target .build-deps -r requirements.txt && PYTHONPATH=.build-deps python3 scripts/vercel-build.py",
  "functions": {
    "api/index.py": {
      "excludeFiles": "{.agents/**,docs/**,policies/**,records/**,scripts/**,deploy/**,.build-deps/**,state_import.py,**/.env*,.board_snapshot*,.python-version,test_*.py,**/test_*.py,**/__pycache__/**,**/*.pyc,github-app/**,.pytest_cache/**,site/**}"
    }
  },
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/api?__acp_path=/:path*"
    }
  ]
}
