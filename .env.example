# acp-gateway configuration. Copy to .env (git-ignored) and fill in values; never commit real ones.
# Every variable is documented in README.md, "Environment variables". This file lists what a
# self-hosted deployment needs to start, in the order the "Self-hosting" section sets them up.

# --- Required ---------------------------------------------------------------------------------
# Bearer every caller presents. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ACP_GATEWAY_TOKEN=

# --- Policy authority (set before real use) ---------------------------------------------------
# HMAC key that signs policies, callers and budget documents. Generate as above, keep it offline.
ACP_POLICY_SIGNING_KEY=
# Separate credential for changes to ACP itself (documents, grants, recovery). Generate as above.
ACP_POLICY_ADMIN_TOKEN=
# The signed policy document as literal JSON (scripts/register-policy.py writes it), or a file path.
# ACP_POLICY=
# ACP_POLICY_FILE=/path/to/policy.json
# Owners this deployment governs, comma-separated, or * (an empty value governs no owner).
ACP_POLICY_SCOPE=*
# 1 makes startup fail unless signing, durable state and the audit chain are configured.
ACP_REQUIRE_PRODUCTION_CONTROLS=1

# --- GitHub App (repository verification and board reads) -------------------------------------
ACP_GITHUB_APP_ID=
# The App's PEM private key as a literal value, not a path.
ACP_GITHUB_PRIVATE_KEY=
# Boards agents may read, e.g. <owner>:* ; empty means none.
ACP_PROJECT_ALLOWLIST=

# --- Storage ----------------------------------------------------------------------------------
# file (default off Vercel) or postgres (required for metered actions and multiple hosts).
ACP_STORAGE_BACKEND=file
# File mode: where containment, incidents and trust state persist.
ACP_SECURITY_STATE_FILE=./state/security-state.json
ACP_TRUST_STATE_FILE=./state/trust-state.json
ACP_AUDIT_HASH_CHAIN=1
# Postgres mode: runtime connection URL, and the owner URL scripts/migrate-db.py applies migrations with.
# ACP_DATABASE_URL=
# ACP_DATABASE_MIGRATION_URL=
# A read-only role's URL: enough for migrate-db.py --check, release.py without pending migrations, and analysis.
# ACP_DATABASE_READ_URL=

# --- Metered builds (optional) ----------------------------------------------------------------
# Signed deployment-wide limits; without it every metered action is refused.
# ACP_BUDGET_POLICY=
# Read-only provider tokens for build evidence.
# ACP_VERCEL_TOKEN=
# ACP_VERCEL_TEAM_ID=
# ACP_RAILWAY_TOKEN=
# How refusals tell agents to request an owner grant (how your operator runs scripts/policy-admin.py).
# ACP_GRANT_COMMAND_PREFIX=python3 scripts/policy-admin.py

# --- Operator scripts (scripts/policy-admin.py, acp_ops.py, release.py) ------------------------
# Your gateway's hostnames; the scripts send tokens only to these over TLS (or to loopback).
# ACP_GATEWAY_HOSTS=acp.example.com
# ACP_GATEWAY_URL=https://acp.example.com
# A second host whose policies posture-report compares, if you run two.
# ACP_RAILWAY_URL=
# macOS Keychain service the scripts read credentials from when they are not in the environment.
# ACP_KEYCHAIN_SERVICE=ACP Gateway Production
